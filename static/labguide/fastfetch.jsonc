// Independent of static/fastfetch/config.jsonc so the pane's module list can be
// tuned without changing the terminal fastfetch.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    {
      "type": "command",
      "key": "You're sitting at codeship workstation -",
      "text": "hostname"
    },
    {
      "type": "os",
      "key": "os"
    },
    {
      "type": "kernel",
      "key": "kernel"
    },
    {
      "type": "uptime",
      "key": "uptime"
    },
    {
      "type": "packages",
      "key": "packages"
    },
    {
      "type": "wm",
      "key": "wm"
    },
    {
      "type": "cpu",
      "key": "cpu"
    },
    {
      "type": "gpu",
      "key": "gpu"
    },
    {
      "type": "memory",
      "key": "memory"
    },
    {
      "type": "disk",
      "key": "disk"
    }
  ]
}
